@startuml
title Bookinfo Kubernetes Architecture

left to right direction
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam ArrowColor #4B5563
skinparam packageBorderColor #94A3B8
skinparam packageBackgroundColor #F8FAFC
skinparam componentBorderColor #2563EB
skinparam componentBackgroundColor #EFF6FF
skinparam nodeBorderColor #16A34A
skinparam nodeBackgroundColor #F0FDF4

actor "User" as user

cloud "External traffic" as external

package "Kubernetes cluster" {
  package "Entry point (choose one)" #FEF3C7 {
    component "Kubernetes Ingress\n(optional)" as ingress
    component "Istio ingress gateway\nGateway + VirtualService\n(optional)" as istio_ingress
    component "Gateway API\nGateway + HTTPRoute\n(optional)" as gateway_api
  }

  package "Bookinfo namespace" {
    component "Service\nproductpage :9080" as productpage_svc
    node "Deployment: productpage-v1\nPod: productpage\n+ Envoy sidecar" as productpage_pod

    component "Service\ndetails :9080" as details_svc
    node "Deployment: details-v1\nPod: details\n+ Envoy sidecar" as details_pod

    component "Service\nreviews :9080" as reviews_svc
    node "reviews-v1\nPod + Envoy" as reviews_v1
    node "reviews-v2\nPod + Envoy" as reviews_v2
    node "reviews-v3\nPod + Envoy" as reviews_v3

    component "Service\nratings :9080" as ratings_svc
    node "ratings-v1\nPod + Envoy" as ratings_v1
    node "ratings-v2\nPod + Envoy" as ratings_v2

    database "Service: mongodb :27017\n(optional)" as mongodb
    database "Service: mysqldb :3306\n(optional)" as mysql
  }

  package "Istio traffic management (optional)" #F3E8FF {
    component "VirtualService\nroute and traffic split" as virtual_service
    component "DestinationRule\nsubsets by version label\n+ mTLS policy" as destination_rule
  }
}

user --> external
external --> ingress : alternative entry
external --> istio_ingress : alternative entry
external --> gateway_api : alternative entry
ingress --> productpage_svc
istio_ingress --> productpage_svc
gateway_api --> productpage_svc

productpage_svc --> productpage_pod : app=productpage\nversion=v1
productpage_pod --> details_svc
productpage_pod --> reviews_svc
details_svc --> details_pod : app=details\nversion=v1

reviews_svc --> reviews_v1 : app=reviews\nversion=v1
reviews_svc --> reviews_v2 : app=reviews\nversion=v2
reviews_svc --> reviews_v3 : app=reviews\nversion=v3
reviews_v1 --> ratings_svc
reviews_v2 --> ratings_svc
reviews_v3 --> ratings_svc

ratings_svc --> ratings_v1 : app=ratings\nversion=v1
ratings_svc --> ratings_v2 : app=ratings\nversion=v2
ratings_v1 ..> mongodb : optional database
ratings_v2 ..> mysql : optional database

virtual_service ..> productpage_svc : controls ingress route
virtual_service ..> reviews_svc : chooses v1 / v2 / v3
virtual_service ..> ratings_svc : chooses version
destination_rule ..> reviews_svc : defines subsets
destination_rule ..> ratings_svc : defines subsets
destination_rule ..> details_svc : defines subsets

note bottom of virtual_service
Without Istio routing rules, a Kubernetes Service
load-balances across Pods with matching app labels.
end note

legend right
  |= Resource | Role |
  | Service | Stable internal DNS / load-balancing endpoint |
  | Deployment / Pod | Runs a versioned application workload |
  | VirtualService + DestinationRule | Optional Istio routing, subsets, mTLS |
endlegend
@enduml

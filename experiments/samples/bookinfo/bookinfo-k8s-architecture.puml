@startuml
title Bookinfo Kubernetes Architecture

top to bottom direction
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam ArrowColor #4B5563
skinparam packageBorderColor #94A3B8
skinparam packageBackgroundColor #F8FAFC
skinparam componentBorderColor #2563EB
skinparam componentBackgroundColor #EFF6FF
skinparam nodeBorderColor #16A34A
skinparam nodeBackgroundColor #F0FDF4

actor "User" as user

cloud "Internet" as internet

package "Kubernetes cluster" {
  component "NGINX Ingress Controller" as ingress_controller #FEF3C7
  component "Ingress: bookinfo\n/productpage, /static/, /login,\n/logout, /api/v1/products" as ingress

  package "Application namespace" {
    component "Service\nproductpage :9080" as productpage_svc
    node "Deployment: productpage-v1\nPod: productpage" as productpage_pod

    component "Service\ndetails :9080" as details_svc
    node "Deployment: details-v1\nPod: details" as details_pod

    component "Service\nreviews :9080" as reviews_svc
    node "Deployment: reviews-v3\nPod: reviews" as reviews_v3

    component "Service\nratings :9080" as ratings_svc
    node "Deployment: ratings-v2\nPod: ratings\nMONGO_DB_URL configured" as ratings_v2

    component "Service\nmongodb :27017" as mongodb_svc
    node "Deployment: mongodb-v1\nPod: mongodb" as mongodb_pod
    database "PersistentVolumeClaim\nmongodb-data" as mongodb_pvc

    component "ConfigMap\nbookinfo-service-config\nDETAILS_HOSTNAME=details" as runtime_config
    component "Secret\nbookinfo-service-credentials\nREVIEWS_HOSTNAME=reviews" as service_secret
    component "ConfigMap\nreviews-service-config\nRATINGS_SERVICE_PORT=9080" as reviews_config
    component "Secret\nreviews-service-credentials\nRATINGS_HOSTNAME=ratings" as reviews_secret
    component "Secret\nratings-db-credentials\nMONGO_DB_URL" as ratings_secret
    database "PersistentVolumeClaim\nproductpage-workspace" as productpage_pvc
    database "PersistentVolumeClaim\nreviews-logs" as reviews_pvc
    component "NetworkPolicy\nreviews-from-productpage" as reviews_policy
  }
}

user --> internet
internet --> ingress_controller : HTTP
ingress_controller --> ingress
ingress --> productpage_svc : HTTP :9080

productpage_svc --> productpage_pod : app=productpage\nversion=v1
productpage_pod --> details_svc : HTTP :9080
productpage_pod --> reviews_svc : HTTP :9080
details_svc --> details_pod : app=details\nversion=v1

reviews_svc --> reviews_v3 : app=reviews\nversion=v3
reviews_v3 --> ratings_svc : HTTP :9080

ratings_svc --> ratings_v2 : app=ratings\nversion=v2
ratings_v2 --> mongodb_svc : MongoDB :27017
mongodb_svc --> mongodb_pod : app=mongodb\nversion=v1
mongodb_pod --> mongodb_pvc : persistentVolumeClaim\nclaimName=mongodb-data

productpage_pod --> runtime_config : envFrom.configMapRef\nDETAILS_HOSTNAME
productpage_pod --> service_secret : env.valueFrom.secretKeyRef\nREVIEWS_HOSTNAME
productpage_pod --> productpage_pvc : persistentVolumeClaim\nclaimName=productpage-workspace
reviews_v3 --> reviews_config : envFrom.configMapRef\nRATINGS_SERVICE_PORT
reviews_v3 --> reviews_secret : env.valueFrom.secretKeyRef\nRATINGS_HOSTNAME
reviews_v3 --> reviews_pvc : persistentVolumeClaim\nclaimName=reviews-logs
ratings_v2 --> ratings_secret : env.valueFrom.secretKeyRef\nMONGO_DB_URL
reviews_policy --> reviews_v3 : podSelector\napp=reviews, version=v3

note bottom of reviews_svc
The reviews Service selects v3, which requests ratings.
The ratings Service selects its database-backed v2 Pod.
end note

note bottom of service_secret
All dependency relationships are defined by Bookinfo resources
in `platform/kube/`; no separate test namespace is used.
end note

legend right
  |= Resource | Role |
  | Ingress | The only external HTTP entry point |
  | Service | Internal DNS / load-balancing endpoint |
  | Deployment / Pod | Runs a versioned application workload |
  | PVC | Persistent workspace, logs, and ratings data |
  | ConfigMap / Secret / NetworkPolicy | Active Bookinfo deployment and access-control dependencies |
endlegend
@enduml

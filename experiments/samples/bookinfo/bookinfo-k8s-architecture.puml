@startuml
title Bookinfo Kubernetes Architecture

left to right direction
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam ArrowColor #4B5563
skinparam packageBorderColor #94A3B8
skinparam packageBackgroundColor #F8FAFC
skinparam componentBorderColor #2563EB
skinparam componentBackgroundColor #EFF6FF
skinparam nodeBorderColor #16A34A
skinparam nodeBackgroundColor #F0FDF4

actor "User" as user

cloud "Internet" as internet

package "Kubernetes cluster" {
  component "NGINX Ingress Controller" as ingress_controller #FEF3C7
  component "Ingress: bookinfo\n/productpage, /static/, /login,\n/logout, /api/v1/products" as ingress

  package "Application namespace" {
    component "Service\nproductpage :9080" as productpage_svc
    node "Deployment: productpage-v1\nPod: productpage" as productpage_pod

    component "Service\ndetails :9080" as details_svc
    node "Deployment: details-v1\nPod: details" as details_pod

    component "Service\nreviews :9080" as reviews_svc
    node "Deployment: reviews-v3\nPod: reviews" as reviews_v3

    component "Service\nratings :9080" as ratings_svc
    node "Deployment: ratings-v2\nPod: ratings\nMONGO_DB_URL configured" as ratings_v2

    database "Service: mongodb :27017\nDeployment: mongodb-v1" as mongodb
  }
}

user --> internet
internet --> ingress_controller : HTTP
ingress_controller --> ingress
ingress --> productpage_svc : HTTP :9080

productpage_svc --> productpage_pod : app=productpage\nversion=v1
productpage_pod --> details_svc : HTTP :9080
productpage_pod --> reviews_svc : HTTP :9080
details_svc --> details_pod : app=details\nversion=v1

reviews_svc --> reviews_v3 : app=reviews\nversion=v3
reviews_v3 --> ratings_svc : HTTP :9080

ratings_svc --> ratings_v2 : app=ratings\nversion=v2
ratings_v2 --> mongodb : MongoDB :27017

note bottom of reviews_svc
The reviews Service selects v3, which requests ratings.
The ratings Service selects its database-backed v2 Pod.
end note

legend right
  |= Resource | Role |
  | Ingress | The only external HTTP entry point |
  | Service | Internal DNS / load-balancing endpoint |
  | Deployment / Pod | Runs a versioned application workload |
  | MongoDB | Internal ratings data store (ephemeral demo data) |
endlegend
@enduml

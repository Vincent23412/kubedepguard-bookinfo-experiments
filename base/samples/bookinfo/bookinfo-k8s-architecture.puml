@startuml
title Full Bookinfo Kubernetes / Istio Resource Architecture

left to right direction
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam ArrowColor #4B5563
skinparam packageBorderColor #94A3B8
skinparam packageBackgroundColor #F8FAFC
skinparam componentBorderColor #2563EB
skinparam componentBackgroundColor #EFF6FF
skinparam nodeBorderColor #16A34A
skinparam nodeBackgroundColor #F0FDF4

actor "User" as user
cloud "External traffic" as external

package "Kubernetes cluster" {
  component "External entry — choose one\n• Kubernetes Ingress (NGINX)\n• Istio Gateway + edge VirtualService\n• Gateway API Gateway + HTTPRoute\n• productpage NodePort" as entry #FEF3C7

  package "Bookinfo application namespace" {
    component "Service\nproductpage :9080" as productpage_svc
    node "Deployment\nproductpage-v1\nPod + Envoy sidecar" as productpage

    component "Service\ndetails :9080" as details_svc
    node "details-v1\ndefault" as details_v1
    node "details-v2\noptional variant" as details_v2

    component "Service\nreviews :9080" as reviews_svc
    node "reviews-v1" as reviews_v1
    node "reviews-v2" as reviews_v2
    node "reviews-v3" as reviews_v3

    component "Service\nratings :9080" as ratings_svc
    node "ratings-v1\nin-memory" as ratings_v1
    node "ratings-v2\nMongoDB-backed" as ratings_v2
    node "ratings-v2-mysql\nMySQL or VM-backed" as ratings_mysql

    database "mongodb\nService :27017\nmongodb-v1" as mongodb
    database "mysqldb\nService :3306\nSecret + mysqldb-v1" as mysql
  }

  package "Restored optional resource sets — apply only the scenario required" #F3E8FF {
    component "Istio routing\nDestinationRules: all, mTLS, reviews\nVirtualServices: all-v1, details-v2,\nreviews v1/v3/v2-v3 and weighted splits\nratings DB / MySQL / delay / abort" as routing
    component "Gateway and edge resources\nnetworking/bookinfo-gateway.yaml\ncertmanager-gateway.yaml\ngateway-api: bookinfo gateway,\nall-v1 and reviews route variants" as gateways
    component "Workload profiles and versions\nbookinfo.yaml • dualstack • PSA\nper-service / discovery overlays\nbookinfo-versions.yaml" as workloads
    component "Supporting capabilities\nMongoDB and MySQL manifests\ncertificate + cert-manager gateway\nGoogle APIs egress, details fault injection\nEnvoy rate limit, Swagger, Istio demo profile" as supporting
  }
}

user --> external
external --> entry
entry --> productpage_svc : HTTP :9080
productpage_svc --> productpage : app=productpage\nversion=v1
productpage --> details_svc : HTTP :9080
productpage --> reviews_svc : HTTP :9080

details_svc --> details_v1 : default
details_svc ..> details_v2 : selected route
reviews_svc --> reviews_v1 : v1
reviews_svc --> reviews_v2 : v2
reviews_svc --> reviews_v3 : v3
reviews_v1 --> ratings_svc
reviews_v2 --> ratings_svc
reviews_v3 --> ratings_svc
ratings_svc --> ratings_v1 : default
ratings_svc ..> ratings_v2 : MongoDB scenario
ratings_svc ..> ratings_mysql : MySQL scenario
ratings_v2 --> mongodb
ratings_mysql --> mysql

routing ..> reviews_svc : version / traffic selection
routing ..> ratings_svc : database and fault scenarios
gateways ..> entry : entry implementation
workloads ..> productpage_svc : selected workload profile
supporting ..> mongodb : database option
supporting ..> productpage : egress / rate-limit option

note bottom of routing
The default Bookinfo workload is `platform/kube/bookinfo.yaml`.
The restored files are alternatives, overlays, or test scenarios; they are not
intended to be applied together.
end note

legend right
  |= Style | Meaning |
  | Solid arrow | Default request or dependency path |
  | Dotted arrow | Optional configuration or scenario |
  | Green node | Versioned application workload |
  | Purple package | Restored Istio / platform resource collection |
endlegend
@enduml
